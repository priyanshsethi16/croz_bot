[Unit]
Description=GROZ Catalog RAG V2 ingestion worker
After=network.target postgresql.service qdrant.service

[Service]
Type=simple
WorkingDirectory=%h/groz/croz_bot
EnvironmentFile=%h/groz/croz_bot/.env
ExecStart=%h/groz/croz_bot/.venv/bin/python groz_ui/manage.py catalog_v2_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
