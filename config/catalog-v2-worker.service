[Unit]
Description=GROZ Catalog RAG V2 ingestion worker
After=network.target postgresql.service qdrant.service

[Service]
Type=simple
WorkingDirectory=/home/jazlaan/groz/croz_bot
EnvironmentFile=/home/jazlaan/groz/croz_bot/.env
ExecStart=/home/jazlaan/groz/croz_bot/.venv/bin/python groz_ui/manage.py catalog_v2_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
